{
  "manifest_version": 3,
  "name": "Hola Anisong Sub-Ser",
  "version": "1.1.0",
  "description": "Hiển thị phụ đề (ASS/SRT/VTT) trực tiếp trên YouTube",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.workers.dev/*",
    "*://*.pages.dev/*",
    "*://raw.githubusercontent.com/*",
    "*://api.github.com/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["ass-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}