{
  "manifest_version": 3,
  "name": "Hola Anisong Sub-Server",
  "version": "1.0",
  "description": "Hiển thị bản dịch nhạc của Hola Anisong trên mọi video YouTube.",
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "*://*.youtube.com/*",
    "*://*.workers.dev/*",
    "*://*.pages.dev/*"
  ],
  "action": {
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["*://*.youtube.com/*"],
      "js": ["ass-parser.js", "content.js"],
      "run_at": "document_idle"
    }
  ]

  ,
  "web_accessible_resources": [
    {
      "resources": ["popup.html", "popup.css", "popup.js"],
      "matches": ["*://*.youtube.com/*"]
    }
  ]
}